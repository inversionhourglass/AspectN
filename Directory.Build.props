<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RepositoryUrl>https://github.com/AspectN/AspectN</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>AspectN contributors</Authors>
    <Copyright>Copyright © AspectN contributors</Copyright>
    <_AspectNProductionParent>$([System.IO.Path]::GetDirectoryName('$(MSBuildProjectDirectory)'))</_AspectNProductionParent>
    <_AspectNSourceDirectory>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'src'))</_AspectNSourceDirectory>
  </PropertyGroup>
  <!-- 生产库均位于 src 的直接子目录；这些默认值必须在 SDK 计算文档输出路径之前设置。 -->
  <PropertyGroup Condition="'$(_AspectNProductionParent)' == '$(_AspectNSourceDirectory)'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
