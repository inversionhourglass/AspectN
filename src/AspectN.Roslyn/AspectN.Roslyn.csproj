<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>AspectN.Roslyn</PackageId>
    <Description>Microsoft.CodeAnalysis adapter for AspectN metadata matching.</Description>
    <PackageTags>aspectn;roslyn;compiler;source-analysis</PackageTags>
    <PackageProjectUrl>https://github.com/AspectN/AspectN</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AspectN\AspectN.csproj" />
    <Compile Include="..\Shared\OperatorMetadata.cs" Link="Internal\OperatorMetadata.cs" />
    <Compile Include="..\Shared\AttributeAvailability.cs" Link="Internal\AttributeAvailability.cs" />
    <Compile Include="..\Shared\IterativeTypeMapping.cs" Link="Internal\IterativeTypeMapping.cs" />
    <Compile Include="..\Shared\NativeTypeLimitGuard.cs" Link="Internal\NativeTypeLimitGuard.cs" />
    <Compile Include="..\Shared\IterativeTypeText.cs" Link="Internal\IterativeTypeText.cs" />
    <Compile Include="..\Shared\MetadataEncodedAttributes.cs" Link="Internal\MetadataEncodedAttributes.cs" />
    <Compile Include="..\Shared\ArrayRelations.cs" Link="Internal\ArrayRelations.cs" />
    <Compile Include="..\Shared\FunctionPointerConventions.cs" Link="Internal\FunctionPointerConventions.cs" />
    <Compile Include="..\Shared\GenericOwnerIdentity.cs" Link="Internal\GenericOwnerIdentity.cs" />
    <Compile Include="..\Shared\UnqualifiedStructuralComparer.cs" Link="Internal\UnqualifiedStructuralComparer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
