<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>AspectN.Cecil.Fody</PackageId>
    <Description>Fody-compatible Mono.Cecil adapter for AspectN metadata matching.</Description>
    <PackageTags>aspectn;fody;mono-cecil;il-weaving;metadata</PackageTags>
    <PackageProjectUrl>https://github.com/AspectN/AspectN</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AspectN\AspectN.csproj" />
    <Compile Include="..\Shared\OperatorMetadata.cs" Link="Internal\OperatorMetadata.cs" />
    <Compile Include="..\Shared\AttributeAvailability.cs" Link="Internal\AttributeAvailability.cs" />
    <Compile Include="..\Shared\ArrayRelations.cs" Link="Internal\ArrayRelations.cs" />
    <Compile Include="..\Shared\FunctionPointerConventions.cs" Link="Internal\FunctionPointerConventions.cs" />
    <Compile Include="..\Shared\GenericOwnerIdentity.cs" Link="Internal\GenericOwnerIdentity.cs" />
    <Compile Include="..\Shared\UnqualifiedStructuralComparer.cs" Link="Internal\UnqualifiedStructuralComparer.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\AspectN.Cecil\**\*.cs"
             Exclude="..\AspectN.Cecil\bin\**;..\AspectN.Cecil\obj\**"
             Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FodyHelpers" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="..\AspectN.Cecil\PublicAPI.Shipped.txt"
                     Link="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="..\AspectN.Cecil\PublicAPI.Unshipped.txt"
                     Link="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
