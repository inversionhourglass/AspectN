<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\OwnerIdentityFixture.cs" Link="SharedTests\OwnerIdentityFixture.cs" />
    <Compile Include="..\Shared\CustomModifierOwnerFixture.cs" Link="SharedTests\CustomModifierOwnerFixture.cs" />
    <ProjectReference Include="..\..\src\AspectN.Cecil.Fody\AspectN.Cecil.Fody.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\AspectN.Cecil.Tests\**\*.cs"
             Exclude="..\AspectN.Cecil.Tests\bin\**;..\AspectN.Cecil.Tests\obj\**;..\AspectN.Cecil.Tests\Usings.cs"
             Link="SharedTests\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FodyHelpers" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
</Project>
