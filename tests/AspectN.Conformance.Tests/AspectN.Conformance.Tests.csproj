<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\CustomModifierOwnerFixture.cs" Link="SharedTests\CustomModifierOwnerFixture.cs" />
    <ProjectReference Include="..\..\src\AspectN.Cecil\AspectN.Cecil.csproj" />
    <ProjectReference Include="..\..\src\AspectN.Reflection\AspectN.Reflection.csproj" />
    <ProjectReference Include="..\..\src\AspectN.Roslyn\AspectN.Roslyn.csproj" />
    <ProjectReference Include="..\AspectN.TestAssembly\AspectN.TestAssembly.csproj" />
    <ProjectReference Include="..\AspectN.MappingDepthProbe\AspectN.MappingDepthProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="conformance-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_NETFramework_ReferenceAssemblies_net472)/build/.NETFramework/v4.7.2/mscorlib.dll"
          Link="framework-references/mscorlib.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyMappingDepthProbe" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="../AspectN.MappingDepthProbe/AspectN.MappingDepthProbe.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="_MappingDepthProbeTarget" />
    </MSBuild>
    <PropertyGroup>
      <_MappingDepthProbeDirectory>@(_MappingDepthProbeTarget->'%(RootDir)%(Directory)')</_MappingDepthProbeDirectory>
    </PropertyGroup>
    <Error Condition="'$(_MappingDepthProbeDirectory)' == ''" Text="The mapping-depth probe did not provide an output path." />
    <ItemGroup>
      <_MappingDepthProbeFiles Include="$(_MappingDepthProbeDirectory)/**/*" />
      <FileWrites Include="@(_MappingDepthProbeFiles->'$(TargetDir)mapping-depth-probe/%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_MappingDepthProbeFiles)"
          DestinationFiles="@(_MappingDepthProbeFiles->'$(TargetDir)mapping-depth-probe/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
